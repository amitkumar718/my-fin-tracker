<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ldsa.myfintracker">

    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SmsInboxActivity"
            android:label="@string/title_sms_inbox"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".ui.MapExpenseActivity"
            android:label="@string/title_sms_map"
            android:exported="false" />

        <activity
            android:name=".ui.ExpenseDetailActivity"
            android:label="@string/title_expense_detail"
            android:exported="false" />

        <activity
            android:name=".ui.AddExpenseActivity"
            android:label="@string/title_add_expense"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:label="@string/title_settings"
            android:exported="false" />

        <activity
            android:name=".ui.SenderTemplateActivity"
            android:label="@string/title_sender_template"
            android:exported="false" />

        <activity
            android:name=".ui.SmsExtractConfigActivity"
            android:label="@string/title_sms_extract_config"
            android:exported="false" />

        <activity
            android:name=".ui.TripListActivity"
            android:label="@string/label_trips"
            android:exported="false" />

        <activity
            android:name=".ui.TripDetailActivity"
            android:label="@string/title_trip_detail"
            android:exported="false" />

        <activity
            android:name=".ui.EditTripActivity"
            android:label="@string/label_new_trip"
            android:exported="false" />

        <activity
            android:name=".ui.StatementImportActivity"
            android:label="@string/title_statement_import"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".ui.PdfInboxActivity"
            android:label="@string/title_pdf_inbox"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".ui.PdfLinesActivity"
            android:label="@string/title_pdf_lines"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".ui.DropboxPdfInboxActivity"
            android:label="@string/title_dropbox_pdf_inbox"
            android:exported="false" />

        <activity
            android:name=".ui.StatementScanActivity"
            android:label="@string/title_statement_scan"
            android:exported="false" />

        <activity
            android:name=".ui.BankListActivity"
            android:label="@string/title_banks"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".ui.BankConfigActivity"
            android:label="@string/title_bank_config"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".ui.AddPdfPatternActivity"
            android:label="@string/title_add_pdf_pattern"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".ui.DropboxSettingsActivity"
            android:label="@string/title_dropbox_settings"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".ui.PdfLinePickerActivity"
            android:label="@string/title_pick_pdf_lines"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

    </application>

</manifest>

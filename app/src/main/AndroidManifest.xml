<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ldsa.myfintracker">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.READ_SMS" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SmsInboxActivity"
            android:label="@string/title_sms_inbox"
            android:exported="false" />

        <activity
            android:name=".ui.SmsMapActivity"
            android:label="@string/title_sms_map"
            android:exported="false" />

        <activity
            android:name=".ui.ExpenseDetailActivity"
            android:label="@string/title_expense_detail"
            android:exported="false" />

        <activity
            android:name=".ui.AddExpenseActivity"
            android:label="@string/title_add_expense"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:label="@string/title_settings"
            android:exported="false" />

        <activity
            android:name=".ui.SenderTemplateActivity"
            android:label="@string/title_sender_template"
            android:exported="false" />

        <activity
            android:name=".ui.SmsExtractConfigActivity"
            android:label="@string/title_sms_extract_config"
            android:exported="false" />

    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Original SMS reference card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_blue"
            android:elevation="2dp"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Original SMS"
                android:textColor="#1565C0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvSmsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#212121"
                android:textSize="13sp"
                android:textIsSelectable="true" />

        </LinearLayout>

        <!-- Template editor card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_pattern_template"
                android:textColor="#1976D2"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hint_pattern_template"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:layout_marginBottom="8dp" />

            <!-- Token buttons strip -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button android:id="@+id/btnTokAmount"
                        android:layout_width="wrap_content" android:layout_height="32dp"
                        android:text="Amt" android:textSize="11sp" android:textColor="#2E7D32"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="10dp" android:paddingRight="10dp"
                        android:layout_marginRight="6dp" />

                    <Button android:id="@+id/btnTokMerchant"
                        android:layout_width="wrap_content" android:layout_height="32dp"
                        android:text="Merchant" android:textSize="11sp" android:textColor="#1565C0"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="10dp" android:paddingRight="10dp"
                        android:layout_marginRight="6dp" />

                    <Button android:id="@+id/btnTokCard"
                        android:layout_width="wrap_content" android:layout_height="32dp"
                        android:text="Card" android:textSize="11sp" android:textColor="#1565C0"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="10dp" android:paddingRight="10dp"
                        android:layout_marginRight="6dp" />

                    <Button android:id="@+id/btnTokAcNo"
                        android:layout_width="wrap_content" android:layout_height="32dp"
                        android:text="Ac.No" android:textSize="11sp" android:textColor="#1565C0"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="10dp" android:paddingRight="10dp"
                        android:layout_marginRight="6dp" />

                    <Button android:id="@+id/btnTokUpi"
                        android:layout_width="wrap_content" android:layout_height="32dp"
                        android:text="UPI" android:textSize="11sp" android:textColor="#1565C0"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="10dp" android:paddingRight="10dp"
                        android:layout_marginRight="6dp" />

                    <Button android:id="@+id/btnTokDate"
                        android:layout_width="wrap_content" android:layout_height="32dp"
                        android:text="Date" android:textSize="11sp" android:textColor="#6A1B9A"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="10dp" android:paddingRight="10dp"
                        android:layout_marginRight="6dp" />

                    <Button android:id="@+id/btnTokTime"
                        android:layout_width="wrap_content" android:layout_height="32dp"
                        android:text="Time" android:textSize="11sp" android:textColor="#6A1B9A"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="10dp" android:paddingRight="10dp"
                        android:layout_marginRight="6dp" />

                    <Button android:id="@+id/btnTokBalance"
                        android:layout_width="wrap_content" android:layout_height="32dp"
                        android:text="Bal" android:textSize="11sp" android:textColor="#2E7D32"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="10dp" android:paddingRight="10dp"
                        android:layout_marginRight="6dp" />

                    <Button android:id="@+id/btnTokIgnore"
                        android:layout_width="wrap_content" android:layout_height="32dp"
                        android:text="Skip" android:textSize="11sp" android:textColor="#757575"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="10dp" android:paddingRight="10dp" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Editable template -->
            <EditText
                android:id="@+id/etTemplate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:gravity="top"
                android:inputType="textMultiLine|textNoSuggestions"
                android:textSize="13sp"
                android:textColor="#212121"
                android:background="#FAFAFA"
                android:padding="8dp"
                android:typeface="monospace" />

            <!-- Live extraction preview -->
            <TextView
                android:id="@+id/tvExtractPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#ECEFF1"
                android:padding="8dp"
                android:textSize="11sp"
                android:textColor="#37474F"
                android:typeface="monospace"
                android:visibility="gone" />

            <!-- Pattern edit hint — amber, shown when modifying a saved pattern -->
            <TextView
                android:id="@+id/tvPatternHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#FFF8E1"
                android:padding="8dp"
                android:textSize="12sp"
                android:textColor="#E65100"
                android:textStyle="italic"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Expense details card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_expense_details"
                android:textColor="#1976D2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Date + Time row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:layout_marginRight="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/label_date" android:textColor="#757575" android:textSize="12sp" />
                    <EditText android:id="@+id/etDate" android:layout_width="match_parent"
                        android:layout_height="48dp" android:inputType="none"
                        android:focusable="false" android:clickable="true"
                        android:textSize="14sp" android:textColor="#212121" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/label_time" android:textColor="#757575" android:textSize="12sp" />
                    <EditText android:id="@+id/etTime" android:layout_width="match_parent"
                        android:layout_height="48dp" android:inputType="none"
                        android:focusable="false" android:clickable="true"
                        android:textSize="14sp" android:textColor="#212121" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_transaction_type" android:textColor="#757575" android:textSize="12sp" />
            <Spinner android:id="@+id/spinnerTxnType"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginBottom="10dp" />

            <CheckBox android:id="@+id/cbOnline" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/label_online"
                android:textSize="14sp" android:textColor="#212121"
                android:layout_marginBottom="10dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_reason" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etReason" android:layout_width="match_parent"
                android:layout_height="48dp" android:hint="@string/hint_reason"
                android:inputType="textCapSentences" android:textSize="14sp"
                android:textColor="#212121" android:layout_marginBottom="10dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_bank" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etBank" android:layout_width="match_parent"
                android:layout_height="48dp" android:hint="@string/hint_bank"
                android:inputType="text" android:textSize="14sp"
                android:textColor="#212121" android:layout_marginBottom="10dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_remarks" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etRemarks" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="60dp"
                android:gravity="top" android:hint="@string/hint_remarks"
                android:inputType="textMultiLine|textCapSentences"
                android:textSize="14sp" android:textColor="#212121"
                android:layout_marginBottom="16dp" />

            <Button android:id="@+id/btnSave"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="@string/btn_save_and_create_pattern"
                android:textColor="#FFFFFF" android:textSize="14sp"
                android:background="@drawable/bg_button_primary" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

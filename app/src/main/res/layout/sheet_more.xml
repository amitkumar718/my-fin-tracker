<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:paddingBottom="20dp">

    <!-- Grab bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill"
        android:backgroundTint="#CFD8DC" />

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/sheet_more_title"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnSheetClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✕"
            android:textSize="16sp"
            android:textColor="@color/textMuted"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Statements -->
    <LinearLayout
        android:id="@+id/sheetStatements"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="6dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:foreground="?android:attr/selectableItemBackground">
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="PDF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#EF6C00"
            android:gravity="center"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/tileImportBg" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_more_statements"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_more_statements_sub"
                android:textColor="@color/textMuted"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/textHint"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Banks -->
    <LinearLayout
        android:id="@+id/sheetBanks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="6dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:foreground="?android:attr/selectableItemBackground">
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="🏦"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/tileAddBg" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_more_banks"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_more_banks_sub"
                android:textColor="@color/textMuted"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/textHint"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Settings -->
    <LinearLayout
        android:id="@+id/sheetSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="6dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:foreground="?android:attr/selectableItemBackground">
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="⚙"
            android:textSize="16sp"
            android:textColor="@color/textMuted"
            android:gravity="center"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#F5F5F5" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_more_settings"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_more_settings_sub"
                android:textColor="@color/textMuted"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/textHint"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Debug -->
    <LinearLayout
        android:id="@+id/sheetDebug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:foreground="?android:attr/selectableItemBackground">
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="◉"
            android:textSize="14sp"
            android:textColor="@color/orphan"
            android:gravity="center"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/attnRedBg" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_more_debug"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_more_debug_sub"
                android:textColor="@color/textMuted"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/textHint"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>

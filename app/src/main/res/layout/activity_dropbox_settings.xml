<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1976D2"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:paddingLeft="4dp"
            android:paddingRight="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_dropbox_settings"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Status card -->
            <LinearLayout
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <View
                    android:id="@+id/vStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_card"
                    android:layout_marginRight="10dp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dbx_status_no_token"
                    android:textColor="#757575"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTest"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="@string/btn_test_connection"
                    android:textSize="12sp"
                    android:textColor="#1976D2"
                    android:background="@drawable/bg_button_secondary"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:minWidth="0dp"
                    android:layout_marginRight="6dp"
                    android:enabled="false" />

                <Button
                    android:id="@+id/btnBrowse"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="@string/btn_browse_dropbox"
                    android:textSize="12sp"
                    android:textColor="#1976D2"
                    android:background="@drawable/bg_button_secondary"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:minWidth="0dp"
                    android:enabled="false" />

            </LinearLayout>

            <!-- App key / secret card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="App Key"
                    android:textColor="#757575"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etAppKey"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="Your Dropbox app key"
                    android:textSize="13sp"
                    android:textColor="#212121"
                    android:background="@drawable/bg_edittext_outlined"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="App Secret"
                    android:textColor="#757575"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etAppSecret"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="Your Dropbox app secret"
                    android:textSize="13sp"
                    android:textColor="#212121"
                    android:background="@drawable/bg_edittext_outlined"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Connect Dropbox"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:background="@drawable/bg_button_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Opens Dropbox in your browser once. Thereafter the token refreshes automatically."
                    android:textColor="#9E9E9E"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- Token card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_access_token"
                    android:textColor="#757575"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etToken"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:hint="@string/dropbox_token_hint"
                        android:textSize="13sp"
                        android:textColor="#212121"
                        android:background="@drawable/bg_edittext_outlined"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:inputType="textNoSuggestions|textVisiblePassword"
                        android:fontFamily="monospace"
                        android:layout_marginRight="8dp" />

                    <Button
                        android:id="@+id/btnClearToken"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="@string/btn_clear"
                        android:textSize="12sp"
                        android:textColor="#F44336"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:minWidth="0dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dropbox_token_hint_long"
                    android:textColor="#9E9E9E"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- Root folder card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_root_folder"
                    android:textColor="#757575"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etRootFolder"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="@string/hint_root_folder"
                    android:textSize="13sp"
                    android:textColor="#212121"
                    android:background="@drawable/bg_edittext_outlined"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:inputType="textNoSuggestions"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_root_folder_desc"
                    android:textColor="#9E9E9E"
                    android:textSize="11sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/action_save"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/bg_button_primary" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1976D2"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:paddingLeft="4dp"
            android:paddingRight="12dp" />

        <TextView
            android:id="@+id/tvBankConfigTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_bank_config"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDeleteBank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_delete_bank"
            android:textColor="#FFCDD2"
            android:textSize="13sp"
            android:paddingLeft="8dp"
            android:paddingRight="4dp"
            android:visibility="gone" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- Bank Name card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BANK NAME"
                    android:textColor="#1976D2"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etBankName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/hint_bank_name"
                    android:textSize="14sp"
                    android:textColor="#212121"
                    android:background="@drawable/bg_edittext_outlined"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:inputType="textCapWords"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnSaveIdentity"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/action_save"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="@drawable/bg_button_primary" />

            </LinearLayout>

            <!-- SMS card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_sms_section"
                    android:textColor="#1976D2"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <!-- Sender IDs subsection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_sender_ids"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <Button
                        android:id="@+id/btnAddSenderId"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:text="@string/btn_add_sender_id"
                        android:textColor="#1976D2"
                        android:textSize="11sp"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoSenderIds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_sender_ids"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/containerSenderIds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp" />

                <!-- Extraction Patterns subsection -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_sms_patterns_section"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <Button
                        android:id="@+id/btnAddSmsPattern"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:text="@string/btn_add_pattern"
                        android:textColor="#1976D2"
                        android:textSize="11sp"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoSmsPatterns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_sms_patterns"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/containerSmsPatterns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Long-press a row to delete it"
                    android:textColor="#BDBDBD"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- PDF card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_pdf_section"
                    android:textColor="#1976D2"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- PDF Sources subsection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_pdf_sources"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <Button
                        android:id="@+id/btnAddMorePaths"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:text="@string/btn_add_source"
                        android:textColor="#1976D2"
                        android:textSize="11sp"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerPdfSources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp" />

                <!-- Password row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_pdf_password"
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:layout_marginRight="8dp" />

                    <TextView
                        android:id="@+id/tvPdfPassword"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pdf_password_not_set"
                        android:textColor="#9E9E9E"
                        android:textSize="13sp"
                        android:fontFamily="monospace" />

                    <Button
                        android:id="@+id/btnSetPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:text="@string/btn_set_password"
                        android:textColor="#1976D2"
                        android:textSize="11sp"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp" />

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="12dp" />

                <!-- PDF Extraction Patterns -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_pdf_patterns_section"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <Button
                        android:id="@+id/btnAddPdfPattern"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:text="@string/btn_add_pattern"
                        android:textColor="#1976D2"
                        android:textSize="11sp"
                        android:background="@drawable/bg_button_secondary"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoPdfPatterns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_pdf_patterns_bank"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/containerPdfPatterns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Long-press a pattern to delete it"
                    android:textColor="#BDBDBD"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

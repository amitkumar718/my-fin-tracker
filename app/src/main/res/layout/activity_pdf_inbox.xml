<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- Blue header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1976D2"
        android:paddingLeft="12dp"
        android:paddingRight="8dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_pdf_inbox"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAddStatement"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btn_add_statement"
            android:textSize="12sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_spinner_white"
            android:paddingLeft="14dp"
            android:paddingRight="14dp" />

    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvStatementsEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/pdf_inbox_empty_lib"
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:visibility="visible" />

    <!-- Statement list -->
    <ListView
        android:id="@+id/listStatements"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbarStyle="outsideOverlay"
        android:visibility="gone" />

</LinearLayout>

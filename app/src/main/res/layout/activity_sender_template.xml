<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Basic info card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sender Identification"
                android:textColor="#1976D2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Friendly Name" android:textColor="#757575" android:textSize="12sp" />
            <EditText
                android:id="@+id/etDisplayName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_display_name"
                android:inputType="textCapWords"
                android:textSize="14sp"
                android:textColor="#212121"
                android:layout_marginBottom="10dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Sender Pattern" android:textColor="#757575" android:textSize="12sp" />
            <EditText
                android:id="@+id/etPattern"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_sender_pattern"
                android:inputType="text"
                android:textSize="14sp"
                android:textColor="#212121"
                android:layout_marginBottom="10dp" />

            <CheckBox
                android:id="@+id/cbIsRegex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_is_regex"
                android:textSize="14sp"
                android:textColor="#212121" />

        </LinearLayout>

        <!-- Extraction templates card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_extraction_templates"
                android:textColor="#1976D2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use capture group 1 to extract a value, e.g. Rs\.([\d,]+)"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:layout_marginBottom="12dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Amount Regex" android:textColor="#757575" android:textSize="12sp" />
            <EditText
                android:id="@+id/etAmountRegex"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_regex_amount"
                android:inputType="text"
                android:textSize="13sp"
                android:textColor="#212121"
                android:fontFamily="monospace"
                android:layout_marginBottom="10dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Date Regex" android:textColor="#757575" android:textSize="12sp" />
            <EditText
                android:id="@+id/etDateRegex"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_regex_date"
                android:inputType="text"
                android:textSize="13sp"
                android:textColor="#212121"
                android:fontFamily="monospace"
                android:layout_marginBottom="10dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Merchant Regex" android:textColor="#757575" android:textSize="12sp" />
            <EditText
                android:id="@+id/etMerchantRegex"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_regex_merchant"
                android:inputType="text"
                android:textSize="13sp"
                android:textColor="#212121"
                android:fontFamily="monospace"
                android:layout_marginBottom="10dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Card Regex" android:textColor="#757575" android:textSize="12sp" />
            <EditText
                android:id="@+id/etCardRegex"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_regex_card"
                android:inputType="text"
                android:textSize="13sp"
                android:textColor="#212121"
                android:fontFamily="monospace"
                android:layout_marginBottom="10dp" />

        </LinearLayout>

        <!-- Test result card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_blue"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Extraction Test"
                    android:textColor="#1976D2"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTestRegex"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/btn_test_regex"
                    android:textColor="#1976D2"
                    android:textSize="12sp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:background="@drawable/bg_button_secondary" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvTestResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap Test to see what this pattern extracts from the most recent matching SMS."
                android:textColor="#424242"
                android:textSize="12sp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- Save button -->
        <Button
            android:id="@+id/btnSaveSender"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/btn_save_sender"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/bg_button_primary" />

    </LinearLayout>
</ScrollView>

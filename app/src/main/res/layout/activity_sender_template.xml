<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sender Identification"
                android:textColor="#1976D2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Once saved, open SMS Inbox and long-press any message to configure extraction patterns."
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:layout_marginBottom="14dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Friendly Name" android:textColor="#757575" android:textSize="12sp" />
            <EditText
                android:id="@+id/etDisplayName"
            android:background="@drawable/bg_edittext_outlined"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_display_name"
                android:inputType="textCapWords"
                android:textSize="14sp"
                android:textColor="#212121"
                android:layout_marginBottom="10dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Sender Pattern" android:textColor="#757575" android:textSize="12sp" />
            <EditText
                android:id="@+id/etPattern"
            android:background="@drawable/bg_edittext_outlined"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_sender_pattern"
                android:inputType="text"
                android:textSize="14sp"
                android:textColor="#212121"
                android:layout_marginBottom="10dp" />

            <CheckBox
                android:id="@+id/cbIsRegex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_is_regex"
                android:textSize="14sp"
                android:textColor="#212121" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSaveSender"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/btn_save_sender"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_button_primary" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- Blue header: bank selector + pick file button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1976D2"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:gravity="center_vertical">

        <Spinner
            android:id="@+id/spinnerBank"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginRight="6dp"
            android:background="@drawable/bg_spinner_white" />

        <Button
            android:id="@+id/btnPickFile"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btn_pick_statement"
            android:textSize="12sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_spinner_white"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

    </LinearLayout>

    <!-- Status / hint line -->
    <TextView
        android:id="@+id/tvImportStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:textSize="13sp"
        android:textColor="#546E7A"
        android:text="@string/status_pick_file_hint" />

    <!-- Extracted text preview (shown after file load, hidden after scan) -->
    <TextView
        android:id="@+id/tvTextPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="10"
        android:ellipsize="end"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="11sp"
        android:textColor="#37474F"
        android:fontFamily="monospace"
        android:background="#ECEFF1"
        android:visibility="gone" />

    <!-- Scan button -->
    <Button
        android:id="@+id/btnScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="8dp"
        android:text="@string/btn_scan_expenses"
        android:textColor="#FFFFFF"
        android:background="#1976D2"
        android:visibility="gone" />

    <!-- Candidate list (takes all remaining vertical space) -->
    <ListView
        android:id="@+id/lvCandidates"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="2dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="60dp"
        android:scrollbarStyle="outsideOverlay"
        android:visibility="gone" />

    <!-- Import button (floats at bottom when list is shown) -->
    <Button
        android:id="@+id/btnImport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="@string/btn_import_selected"
        android:textColor="#FFFFFF"
        android:background="#388E3C"
        android:visibility="gone" />

</LinearLayout>

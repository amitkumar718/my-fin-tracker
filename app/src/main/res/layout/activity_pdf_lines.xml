<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- Blue header: bank + month -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1976D2"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPdfLinesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/title_pdf_lines" />

    </LinearLayout>

    <!-- Status line -->
    <TextView
        android:id="@+id/tvPdfStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:textSize="12sp"
        android:textColor="#546E7A"
        android:text="@string/status_reading_file" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvPdfEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:drawableTop="@drawable/ic_empty"
        android:drawablePadding="12dp"
        android:text="@string/pdf_lines_hint"
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:visibility="gone" />

    <!-- Line list -->
    <ListView
        android:id="@+id/listPdfLines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbarStyle="outsideOverlay"
        android:visibility="gone" />

</LinearLayout>

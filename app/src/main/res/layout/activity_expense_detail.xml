<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/landingBackground">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/appBarWhite"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">
        <Button
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="18sp"
            android:textColor="@color/colorPrimary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Expense"
            android:textColor="@color/textPrimary"
            android:textSize="20sp"
            android:paddingLeft="4dp" />
        <Button
            android:id="@+id/btnEdit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✏"
            android:textSize="16sp"
            android:textColor="@color/colorPrimary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />
        <Button
            android:id="@+id/btnDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="🗑"
            android:textSize="16sp"
            android:textColor="@color/textMuted"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/hairline" />

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@color/landingBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- VIEW MODE card -->
        <LinearLayout
            android:id="@+id/layoutViewMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textColor="#2E7D32"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_date"
                    android:textColor="#757575"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_time"
                    android:textColor="#757575"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="—"
                    android:textColor="#212121"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="—"
                    android:textColor="#212121"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="10dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_merchant" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvMerchant" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#212121"
                android:textSize="15sp" android:layout_marginBottom="8dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_reason" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvReason" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#212121"
                android:textSize="15sp" android:layout_marginBottom="8dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_card" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvCard" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#212121"
                android:textSize="15sp" android:layout_marginBottom="8dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_account_number" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvAccountNumber" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#212121"
                android:textSize="15sp" android:layout_marginBottom="8dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_balance_after" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvBalance" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#212121"
                android:textSize="15sp" android:layout_marginBottom="8dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_transaction_type" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvOnline" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#1565C0"
                android:textSize="15sp" android:layout_marginBottom="8dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_bank" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvBank" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#212121"
                android:textSize="15sp" android:layout_marginBottom="8dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_original_sms" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvSms" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#616161"
                android:textSize="12sp" android:layout_marginBottom="8dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_remarks" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvRemarks" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#212121"
                android:textSize="14sp" android:layout_marginBottom="8dp" />

            <TextView android:id="@+id/tvPatternLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View pattern →"
                android:textColor="#1976D2"
                android:textSize="13sp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingRight="8dp"
                android:visibility="gone" />

            <!-- Linked expense card — shown when reconciledWithId != -1 -->
            <LinearLayout
                android:id="@+id/layoutLinkedExpense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#EEF2F7"
                android:padding="10dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvLinkedTag"
                        android:layout_width="32dp"
                        android:layout_height="18dp"
                        android:textSize="9sp"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:layout_marginRight="8dp" />

                    <TextView
                        android:id="@+id/tvLinkedHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="#546E7A"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvLinkedMerchant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#212121"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvLinkedDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#9E9E9E"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvLinkedSmsBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#37474F"
                    android:fontFamily="monospace"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnUnreconcile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕ Unlink"
                    android:textSize="11sp"
                    android:textColor="#E53935"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- EDIT MODE card -->
        <LinearLayout
            android:id="@+id/layoutEditMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_amount" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etAmount" android:layout_width="match_parent"
                android:layout_height="48dp" android:hint="@string/hint_amount"
                android:inputType="numberDecimal" android:textSize="16sp" android:textColor="#212121"
                android:layout_marginBottom="10dp" 
                android:background="@drawable/bg_edittext_outlined"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginRight="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/label_date" android:textColor="#757575" android:textSize="12sp" />
                    <EditText android:id="@+id/etDate" android:layout_width="match_parent"
                        android:layout_height="48dp" android:inputType="none" android:focusable="false"
                        android:clickable="true" android:textSize="14sp" android:textColor="#212121" 
                android:background="@drawable/bg_edittext_outlined"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/label_time" android:textColor="#757575" android:textSize="12sp" />
                    <EditText android:id="@+id/etTime" android:layout_width="match_parent"
                        android:layout_height="48dp" android:inputType="none" android:focusable="false"
                        android:clickable="true" android:textSize="14sp" android:textColor="#212121" 
                android:background="@drawable/bg_edittext_outlined"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_merchant" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etMerchant" android:layout_width="match_parent"
                android:layout_height="48dp" android:hint="@string/hint_merchant"
                android:inputType="textCapWords" android:textSize="14sp" android:textColor="#212121"
                android:layout_marginBottom="10dp" 
                android:background="@drawable/bg_edittext_outlined"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_reason" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etReason" android:layout_width="match_parent"
                android:layout_height="48dp" android:hint="@string/hint_reason"
                android:inputType="textCapSentences" android:textSize="14sp" android:textColor="#212121"
                android:layout_marginBottom="10dp" 
                android:background="@drawable/bg_edittext_outlined"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_card" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etCard" android:layout_width="match_parent"
                android:layout_height="48dp" android:hint="@string/hint_card"
                android:inputType="text" android:textSize="14sp" android:textColor="#212121"
                android:layout_marginBottom="10dp" 
                android:background="@drawable/bg_edittext_outlined"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_account_number" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etAccountNumber" android:layout_width="match_parent"
                android:layout_height="48dp" android:hint="@string/hint_account_number"
                android:inputType="text" android:textSize="14sp" android:textColor="#212121"
                android:layout_marginBottom="10dp" 
                android:background="@drawable/bg_edittext_outlined"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_balance_after" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etBalance" android:layout_width="match_parent"
                android:layout_height="48dp" android:hint="@string/hint_balance_field"
                android:inputType="numberDecimal" android:textSize="14sp" android:textColor="#212121"
                android:layout_marginBottom="10dp" 
                android:background="@drawable/bg_edittext_outlined"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <CheckBox android:id="@+id/cbOnline" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/label_online"
                android:textSize="14sp" android:textColor="#212121" android:layout_marginBottom="10dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_bank" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etBank" android:layout_width="match_parent"
                android:layout_height="48dp" android:hint="@string/hint_bank"
                android:inputType="text" android:textSize="14sp" android:textColor="#212121"
                android:layout_marginBottom="10dp" 
                android:background="@drawable/bg_edittext_outlined"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_remarks" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etRemarks" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="72dp"
                android:hint="@string/hint_remarks"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top"
                android:textSize="14sp" android:textColor="#212121"
                android:layout_marginBottom="16dp" 
                android:background="@drawable/bg_edittext_outlined"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

            <Button android:id="@+id/btnSave" android:layout_width="match_parent"
                android:layout_height="48dp" android:text="@string/action_save"
                android:textColor="#FFFFFF" android:textSize="15sp"
                android:background="@drawable/bg_button_primary" />

        </LinearLayout>

        <!-- Labels card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_labels"
                android:textColor="#1976D2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/labelsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <Button
                android:id="@+id/btnAddLabel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/btn_add_label"
                android:textColor="#1976D2"
                android:textSize="13sp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/bg_button_secondary" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

</LinearLayout>

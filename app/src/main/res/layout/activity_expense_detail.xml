<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- VIEW MODE card -->
        <LinearLayout
            android:id="@+id/layoutViewMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textColor="#2E7D32"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_date"
                    android:textColor="#757575"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_time"
                    android:textColor="#757575"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="—"
                    android:textColor="#212121"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="—"
                    android:textColor="#212121"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="10dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_merchant" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvMerchant" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#212121"
                android:textSize="15sp" android:layout_marginBottom="8dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_reason" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvReason" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#212121"
                android:textSize="15sp" android:layout_marginBottom="8dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_card" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvCard" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#212121"
                android:textSize="15sp" android:layout_marginBottom="8dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Transaction type" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvOnline" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#1565C0"
                android:textSize="15sp" android:layout_marginBottom="8dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_bank" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvBank" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#212121"
                android:textSize="15sp" android:layout_marginBottom="8dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_original_sms" android:textColor="#757575" android:textSize="11sp" />
            <TextView android:id="@+id/tvSms" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#616161"
                android:textSize="12sp" android:layout_marginBottom="4dp" />

        </LinearLayout>

        <!-- EDIT MODE card -->
        <LinearLayout
            android:id="@+id/layoutEditMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_amount" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etAmount" android:layout_width="match_parent"
                android:layout_height="48dp" android:hint="@string/hint_amount"
                android:inputType="numberDecimal" android:textSize="16sp" android:textColor="#212121"
                android:layout_marginBottom="10dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginRight="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/label_date" android:textColor="#757575" android:textSize="12sp" />
                    <EditText android:id="@+id/etDate" android:layout_width="match_parent"
                        android:layout_height="48dp" android:inputType="none" android:focusable="false"
                        android:clickable="true" android:textSize="14sp" android:textColor="#212121" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/label_time" android:textColor="#757575" android:textSize="12sp" />
                    <EditText android:id="@+id/etTime" android:layout_width="match_parent"
                        android:layout_height="48dp" android:inputType="none" android:focusable="false"
                        android:clickable="true" android:textSize="14sp" android:textColor="#212121" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_merchant" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etMerchant" android:layout_width="match_parent"
                android:layout_height="48dp" android:hint="@string/hint_merchant"
                android:inputType="textCapWords" android:textSize="14sp" android:textColor="#212121"
                android:layout_marginBottom="10dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_reason" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etReason" android:layout_width="match_parent"
                android:layout_height="48dp" android:hint="@string/hint_reason"
                android:inputType="textCapSentences" android:textSize="14sp" android:textColor="#212121"
                android:layout_marginBottom="10dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_card" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etCard" android:layout_width="match_parent"
                android:layout_height="48dp" android:hint="@string/hint_card"
                android:inputType="text" android:textSize="14sp" android:textColor="#212121"
                android:layout_marginBottom="10dp" />

            <CheckBox android:id="@+id/cbOnline" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/label_online"
                android:textSize="14sp" android:textColor="#212121" android:layout_marginBottom="10dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_bank" android:textColor="#757575" android:textSize="12sp" />
            <EditText android:id="@+id/etBank" android:layout_width="match_parent"
                android:layout_height="48dp" android:hint="@string/hint_bank"
                android:inputType="text" android:textSize="14sp" android:textColor="#212121"
                android:layout_marginBottom="16dp" />

            <Button android:id="@+id/btnSave" android:layout_width="match_parent"
                android:layout_height="48dp" android:text="@string/action_save"
                android:textColor="#FFFFFF" android:textSize="15sp"
                android:background="@drawable/bg_button_primary" />

        </LinearLayout>

        <!-- Labels card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_labels"
                android:textColor="#1976D2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/labelsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <Button
                android:id="@+id/btnAddLabel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/btn_add_label"
                android:textColor="#1976D2"
                android:textSize="13sp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/bg_button_secondary" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

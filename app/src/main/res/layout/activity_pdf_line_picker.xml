<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/landingBackground">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/appBarWhite"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">
        <Button
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="18sp"
            android:textColor="@color/colorPrimary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pick Lines"
            android:textColor="@color/textPrimary"
            android:textSize="20sp"
            android:paddingLeft="4dp" />
        <Button
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/btn_done"
            android:textColor="@color/colorPrimary"
            android:textSize="13sp"
            android:background="@drawable/bg_card"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginRight="4dp"
            android:enabled="false" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/hairline" />


    <!-- Header -->

    <!-- Assignment summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <View android:layout_width="3dp" android:layout_height="14dp" android:background="#1976D2" android:layout_marginRight="8dp" />
            <TextView android:layout_width="52dp" android:layout_height="wrap_content"
                android:text="@string/label_bank_line" android:textColor="#757575" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvBankLinePreview"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/hint_not_set" android:textColor="#9E9E9E" android:textSize="11sp"
                android:fontFamily="monospace" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <View android:layout_width="3dp" android:layout_height="14dp" android:background="#D55E00" android:layout_marginRight="8dp" />
            <TextView android:layout_width="52dp" android:layout_height="wrap_content"
                android:text="@string/label_period_line" android:textColor="#757575" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvPeriodLinePreview"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/hint_not_set" android:textColor="#9E9E9E" android:textSize="11sp"
                android:fontFamily="monospace" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <View android:layout_width="3dp" android:layout_height="14dp" android:background="#009E73" android:layout_marginRight="8dp" />
            <TextView android:layout_width="52dp" android:layout_height="wrap_content"
                android:text="@string/label_trans_line" android:textColor="#757575" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvTransLinePreview"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/hint_not_set" android:textColor="#9E9E9E" android:textSize="11sp"
                android:fontFamily="monospace" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>

    <!-- Status (shown while loading) -->
    <TextView
        android:id="@+id/tvPickerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/msg_pdf_loading"
        android:textColor="#757575"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="visible" />

    <!-- Lines list -->
    <ListView
        android:id="@+id/listPdfLines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:divider="#F0F4F8"
        android:dividerHeight="1dp" />

</LinearLayout>

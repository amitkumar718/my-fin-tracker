<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- SMS body reference card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_blue"
            android:elevation="2dp"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reference SMS"
                android:textColor="#1565C0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvSmsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#212121"
                android:textSize="13sp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- Extraction rules card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Extraction Patterns"
                android:textColor="#1976D2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Write a regex for each field. Use a capture group to extract a value, e.g. Rs\.([\d,]+). Preview updates as you type."
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:layout_marginBottom="14dp" />

            <!-- Amount -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Amount" android:textColor="#757575" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <EditText
                    android:id="@+id/etAmountRegex"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="@string/hint_regex_amount"
                    android:inputType="text"
                    android:textSize="12sp"
                    android:textColor="#212121"
                    android:fontFamily="monospace" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" → "
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvAmountPreview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="#2E7D32"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Date -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Date" android:textColor="#757575" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <EditText
                    android:id="@+id/etDateRegex"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="@string/hint_regex_date"
                    android:inputType="text"
                    android:textSize="12sp"
                    android:textColor="#212121"
                    android:fontFamily="monospace" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" → "
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvDatePreview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="#1565C0"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Merchant -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Merchant" android:textColor="#757575" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <EditText
                    android:id="@+id/etMerchantRegex"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="@string/hint_regex_merchant"
                    android:inputType="text"
                    android:textSize="12sp"
                    android:textColor="#212121"
                    android:fontFamily="monospace" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" → "
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvMerchantPreview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="#1565C0"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Card -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Card / UPI" android:textColor="#757575" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="4dp">
                <EditText
                    android:id="@+id/etCardRegex"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="@string/hint_regex_card"
                    android:inputType="text"
                    android:textSize="12sp"
                    android:textColor="#212121"
                    android:fontFamily="monospace" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" → "
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvCardPreview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="#1565C0"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnSaveExtraction"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/btn_save_extraction"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/bg_button_primary" />

    </LinearLayout>
</ScrollView>
